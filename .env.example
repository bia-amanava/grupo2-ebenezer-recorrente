# ========================================================
# INSTITUTO SOCIAL EBENÉZER — PLATAFORMA EBENÉZER RECORRENTE
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# ========================================================

# Configurações do Servidor Fastify / Node.js
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# Gateway / Provedor de Serviços de Pagamento (PSP)
# Valores aceitos: 'mock' (simulação interna), 'asaas' (Asaas Pix/Cartão), 'efi' (Efí Bank Pix)
PSP_ACTIVE_GATEWAY=mock

# Autoconfirmação no modo Mock (true = aprovação imediata; false = requer webhook ou simulação)
PSP_MOCK_AUTO_CONFIRM=false

# Credenciais para Integração com Asaas (Produção / Sandbox)
# Preencha se PSP_ACTIVE_GATEWAY for definido como 'asaas'
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Credenciais para Integração com Efí Bank (Bacen Pix / Pix Automático)
# Preencha se PSP_ACTIVE_GATEWAY for definido como 'efi'
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=

# Segurança & Criptografia (JWT para Sessão do Backoffice e Portal do Doador)
# ATENÇÃO: Em produção, utilize uma chave forte de no mínimo 32 caracteres gerada aleatoriamente
JWT_SECRET=ebenezer_dev_secret_key_change_in_production_with_min_32_chars!

# Notificações e E-mails Transacionais
EMAIL_FROM=doacoes@ebenezer.org.br
